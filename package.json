{
  "name": "roadfm-lite",
  "private": true,
  "description": "Command shortcuts for RoadFM-Lite (Python code; npm is only a task runner). Run from the repo root.",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "setup:cpu": "bash scripts/setup.sh --cpu",
    "setup:native": "bash scripts/setup.sh --native",
    "setup:venv": "bash scripts/setup_venv.sh",
    "setup:venv:check": "bash scripts/setup_venv.sh --check",
    "gpu:check": "${PY:-.venv-train/bin/python} scripts/gpu_check.py",
    "gpu:require": "${PY:-.venv-train/bin/python} scripts/gpu_check.py --require-gpu",
    "ec2:bootstrap": "bash scripts/ec2_bootstrap.sh",
    "ec2:bootstrap:docker": "bash scripts/ec2_bootstrap.sh --docker",
    "ec2:bootstrap:root": "bash scripts/ec2_bootstrap.sh --allow-root",
    "ec2:check": "bash scripts/ec2_bootstrap.sh --check",
    "ec2:dry-run": "bash scripts/ec2_bootstrap.sh --dry-run",
    "ec2:sim": "docker compose -f docker/ec2-sim/compose.yml run --rm root",
    "ec2:sim:ubuntu": "docker compose -f docker/ec2-sim/compose.yml run --rm ubuntu",
    "train:check": "${PY:-.venv-train/bin/python} -m src.model.benign_gridsybil.timesnet.train --check",
    "train:smoke": "${PY:-.venv-train/bin/python} -m src.model.benign_gridsybil.timesnet.train --smoke",
    "train:one-batch": "${PY:-.venv-train/bin/python} -m src.model.benign_gridsybil.timesnet.train --smoke --max-steps 1 --run-id one-batch",
    "train": "${PY:-.venv-train/bin/python} -m src.model.benign_gridsybil.timesnet.train",
    "train:full": "${PY:-.venv-train/bin/python} -m src.model.benign_gridsybil.timesnet.train --max-hours 1",
    "train:full:no-guard": "${PY:-.venv-train/bin/python} -m src.model.benign_gridsybil.timesnet.train --max-hours 2 --no-resource-guard",
    "train:recon-only": "${PY:-.venv-train/bin/python} -m src.model.benign_gridsybil.timesnet.train --preset recon_only",
    "train:resume": "${PY:-.venv-train/bin/python} -m src.model.benign_gridsybil.timesnet.train --resume",
    "train:help": "${PY:-.venv-train/bin/python} -m src.model.benign_gridsybil.timesnet.train --help",
    "train:runs": "ls -1t src/runs/pretraining/benign_gridsybil/T64 2>/dev/null",
    "pipeline:prepare": "${PY:-.venv-train/bin/python} scripts/run_notebook.py src/pipeline/input_representation.ipynb",
    "pipeline:encoder-input": "${PY:-.venv-train/bin/python} scripts/run_notebook.py src/pipeline/benign_gridsybil/encoder_input_T64.ipynb",
    "test": "${PY:-.venv-train/bin/python} -m pytest",
    "format": "${PY:-.venv-train/bin/python} -m black src scripts",
    "format:check": "${PY:-.venv-train/bin/python} -m black --check src scripts",
    "check": "npm run format:check && npm test",
    "sim": "npm --prefix simulation run dev",
    "sim:data": "${PY:-.venv-train/bin/python} scripts/export_encoder_sample.py",
    "sim:build": "npm --prefix simulation run build",
    "sim:test": "npm --prefix simulation run test",
    "sim:typecheck": "npm --prefix simulation run typecheck",
    "hf:whoami": "${PY:-.venv-train/bin/python} scripts/hf_hub.py whoami",
    "data:upload": "${PY:-.venv-train/bin/python} scripts/hf_hub.py upload-dataset",
    "data:download": "${PY:-.venv-train/bin/python} scripts/hf_hub.py download-dataset",
    "data:upload-input": "${PY:-.venv-train/bin/python} scripts/hf_hub.py upload-encoder-input",
    "data:download-input": "${PY:-.venv-train/bin/python} scripts/hf_hub.py download-encoder-input",
    "data:upload-input:all": "${PY:-.venv-train/bin/python} scripts/hf_hub.py upload-encoder-input --all",
    "data:download-input:all": "${PY:-.venv-train/bin/python} scripts/hf_hub.py download-encoder-input --all",
    "model:upload": "${PY:-.venv-train/bin/python} scripts/hf_hub.py upload-model",
    "model:download": "${PY:-.venv-train/bin/python} scripts/hf_hub.py download-model",
    "model:list": "${PY:-.venv-train/bin/python} scripts/hf_hub.py list-models",
    "docker:build": "docker compose build gpu",
    "docker:build:cpu": "docker compose build cpu",
    "docker:shell": "docker compose run --rm gpu bash",
    "docker:shell:cpu": "docker compose run --rm cpu bash",
    "docker:check:cpu": "docker compose run --rm cpu npm run train:check",
    "docker:train": "docker compose run --rm gpu npm run train:full"
  }
}
